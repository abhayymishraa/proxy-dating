# Set ONE of these. Anthropic wins if both are set (override with LLM_PROVIDER=anthropic|openai)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
APIFY_TOKEN=
# Protects /api/admin (bulk seed + dating rounds)
ADMIN_TOKEN=
# Optional
# LLM_MODEL=claude-opus-5-5   # or gpt-5.6 for OpenAI
# DATES_PER_PERSON=3
# DATE_TURNS=12
# DB_PATH=/data/cupid.db
# SUBMISSIONS_PER_IP_PER_DAY=5
